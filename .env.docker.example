# Example environment for running NestPro with Docker / docker-compose
# Copy relevant values into your deployment .env or pass as environment variables.

APP_NAME=NestPro
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=http://your-server-domain-or-ip:8080

LOG_CHANNEL=stderr
LOG_LEVEL=info

# --- Database (MySQL service from docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=nestpro
DB_USERNAME=nestpro
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- App drivers (work well with DB-only setup) ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Docker runtime behavior ---
APP_PORT=8080
RUN_MIGRATIONS=true

# If you run behind a reverse proxy / TLS terminator, set APP_URL to the public https URL.
# You may also need to configure trusted proxies in the app for correct scheme/host detection.
