# Example environment for running NestPro with Docker.
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# Then run:
#   ENV_FILE=.env.docker ./docker-build-run.sh
#
# You can also use these values with docker-compose.yml.

APP_NAME=NestPro
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
# Public URL of the app (use :2030 for docker-build-run.sh default, or your domain/https URL)
APP_URL=http://your-server-domain-or-ip:2030

LOG_CHANNEL=stderr
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database details (put your database connection info here)
# -----------------------------------------------------------------------------
# Supported connections: sqlite, mysql, mariadb, pgsql, sqlsrv
DB_CONNECTION=mysql

# Database host
# - docker-compose.yml (bundled db service): db
# - docker-build-run.sh with external/remote database: your database hostname or IP
DB_HOST=your-database-host

DB_PORT=3306
DB_DATABASE=nestpro
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# Optional: full database URL (if set, it can override the individual DB_* values above)
# DB_URL=

# Only used by the MySQL container defined in docker-compose.yml
DB_ROOT_PASSWORD=change-me-root

# --- App drivers (database-backed drivers work without Redis) ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# --- Docker runtime behavior ---
# Host port used by docker-compose.yml (docker-build-run.sh defaults to 2030 unless HOST_PORT is set)
APP_PORT=2030
RUN_MIGRATIONS=true

# If you run behind a reverse proxy / TLS terminator, set APP_URL to the public https URL.
# You may also need to configure trusted proxies in the app for correct scheme/host detection.
